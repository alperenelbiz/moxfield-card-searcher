# moxfield-card-searcher runtime knobs (all optional, all read by the UI server).
# Copy to .env and edit if you want non-default values.

# Address the server binds to. Keep loopback unless you know what you're doing.
MOXFIELD_CARD_SEARCHER_HOST=127.0.0.1

# Port the server binds to.
MOXFIELD_CARD_SEARCHER_PORT=8000

# Path to the SQLite database file. Relative to the working directory when
# you launch the server.
MOXFIELD_CARD_SEARCHER_DB=binders.db
